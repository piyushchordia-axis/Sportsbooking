# ---- API ----
NODE_ENV=development
API_PORT=3001

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://sportsbooking:sportsbooking@localhost:5432/sportsbooking?schema=public
# A separate connection string that uses a role which BYPASSES RLS (for migrations / super-admin).
# In dev this can be the same superuser; in prod use a dedicated role.
DATABASE_ADMIN_URL=postgresql://sportsbooking:sportsbooking@localhost:5432/sportsbooking?schema=public

# Redis (slot locks / queues)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
OTP_TTL_SECONDS=300

# Razorpay (test keys)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# Messaging
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_API_URL=
SMS_API_KEY=
# driver: "log" (dev, prints to console) | "live"
NOTIFICATION_DRIVER=log

# Loyalty / referral platform defaults (owner-overridable)
DEFAULT_LOYALTY_EARN_RATE=0.05
DEFAULT_LOYALTY_REDEEM_VALUE=1
DEFAULT_REFERRAL_REWARD=100

# ---- WEB ----
VITE_API_BASE_URL=http://localhost:3001
