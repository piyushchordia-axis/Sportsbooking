# ───────────────────────────────────────────────────────────────────────────
# Sportline production env. Copy to `.env` next to docker-compose.prod.yml and
# fill in. NEVER commit the filled-in .env (it's gitignored + .dockerignored).
# ───────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Database (host Postgres, reached over the bind-mounted Unix socket) ──────
# Two roles, by design (see apps/api/src/db/role-setup.sql):
#   DATABASE_URL        → the RESTRICTED runtime role `sportsbooking_app`
#                         (NOSUPERUSER, NOBYPASSRLS) the API runs as, so
#                         Row-Level Security is actually enforced.
#   DATABASE_ADMIN_URL  → an ADMIN/owner role used ONLY by `db:push` + `db:seed`
#                         to run DDL, create RLS functions, and create the
#                         runtime role. The running API never uses this.
# Socket form: empty host + `?host=/var/run/postgresql` (no TCP password over
# the network). Replace the runtime password to match role-setup.sql.
DATABASE_URL=postgresql://sportsbooking_app:CHANGE_ME_APP_PASSWORD@/sportsbooking?host=/var/run/postgresql
DATABASE_ADMIN_URL=postgresql://ADMIN_ROLE:CHANGE_ME_ADMIN_PASSWORD@/sportsbooking?host=/var/run/postgresql

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED — the API refuses to boot in production without a strong value.
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_base64_48

# ── CORS ────────────────────────────────────────────────────────────────────
# The SPA is served same-origin (through the web container), so cross-origin
# isn't normally exercised — but set this to the public URL so any direct API
# calls are allow-listed. Comma-separated for multiple origins.
WEB_ORIGIN=https://CHANGE_ME.enaacreations.com

# ── Player OTP login ────────────────────────────────────────────────────────
# Player login is mobile-OTP. Satisfy it one of two ways:
#
# (A) LAUNCH NOW — fixed code, no SMS provider needed. Every OTP is this value,
#     so players just type it. ⚠️ SECURITY: a fixed code lets ANYONE log in as
#     ANY mobile number — REMOVE this before a real public launch.
STATIC_OTP=0000
NOTIFICATION_DRIVER=log
#
# (B) LIVE SMS (delete STATIC_OTP first) — deliver a real CSPRNG code. The
#     sender POSTs JSON {"to","message"} to SMS_API_URL with Authorization:
#     SMS_API_KEY. For MSG91/Twilio/Gupshup (different request shape) we'll add
#     a provider adapter — just share your MSG91 auth key + DLT template id.
# NOTIFICATION_DRIVER=live
# SMS_API_URL=__FILL_SMS_GATEWAY_URL__
# SMS_API_KEY=__FILL_SMS_GATEWAY_KEY__
#
# Production REFUSES TO BOOT if neither STATIC_OTP nor a live SMS gateway is set
# (a misconfig can't silently break login). ALLOW_NO_SMS=true forces boot anyway
# (owner/admin console works; player OTP login disabled).

# ── Payments (OPTIONAL) ─────────────────────────────────────────────────────
# Leave blank to launch with Pay-at-venue only. Online payments need LIVE keys
# (rzp_live_...). Without them the order path mocks — fine for pay-at-venue, not
# for taking real money online.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ── Storage ─────────────────────────────────────────────────────────────────
# Default: local disk on the sb_uploads volume (STORAGE_LOCAL_DIR=/data/uploads
# is set by compose). Public URL for uploaded logos/photos MUST be the real
# origin, else the SPA renders broken image links. Served by nginx at /uploads.
STORAGE_LOCAL_BASE_URL=https://CHANGE_ME.enaacreations.com/uploads
# For S3/R2 instead of local disk:
# STORAGE_BUCKET=
# STORAGE_PUBLIC_BASE_URL=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Compose (host) ──────────────────────────────────────────────────────────
# Loopback port the host's public Nginx proxies into. Pick one not already in
# use (8080 + 8090 are taken on this server).
WEB_PORT=8093
