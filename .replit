modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NODE_ENV = "development"
API_PORT = "3001"
# JWT_SECRET is intentionally NOT set here — never commit a secret. In dev the API
# uses a local fallback (NODE_ENV=development); set a real JWT_SECRET via Replit
# Secrets if this workspace ever runs against shared/production data.
JWT_ACCESS_TTL = "900"
JWT_REFRESH_TTL = "2592000"
OTP_TTL_SECONDS = "300"
RAZORPAY_KEY_ID = "rzp_test_placeholder"
RAZORPAY_KEY_SECRET = "placeholder"
RAZORPAY_WEBHOOK_SECRET = "placeholder"
NOTIFICATION_DRIVER = "log"
DEFAULT_LOYALTY_EARN_RATE = "0.05"
DEFAULT_LOYALTY_REDEEM_VALUE = "1"
DEFAULT_REFERRAL_REWARD = "100"
VITE_API_BASE_URL = "http://localhost:3001"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/api && NODE_ENV=development API_PORT=3001 DATABASE_URL=$DATABASE_URL node dist/main.js"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/web && pnpm dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

# NOTE: no [deployment] block — this app deploys via Docker on the host server
# (see deploy/), NOT Replit. A Replit autoscale deploy here would run the app on a
# public host in development mode; it is intentionally omitted. Deploy with
# deploy/deploy.sh. (The old block also called `npx prisma generate`, stale since
# the Drizzle migration.)

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
