modules = ["nodejs-20", "web"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NODE_ENV = "development"
API_PORT = "3001"
JWT_SECRET = "dev-jwt-secret-change-in-prod"
JWT_ACCESS_TTL = "900"
JWT_REFRESH_TTL = "2592000"
OTP_TTL_SECONDS = "300"
RAZORPAY_KEY_ID = "rzp_test_placeholder"
RAZORPAY_KEY_SECRET = "placeholder"
RAZORPAY_WEBHOOK_SECRET = "placeholder"
NOTIFICATION_DRIVER = "log"
DEFAULT_LOYALTY_EARN_RATE = "0.05"
DEFAULT_LOYALTY_REDEEM_VALUE = "1"
DEFAULT_REFERRAL_REWARD = "100"
VITE_API_BASE_URL = "http://localhost:3001"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/api && NODE_ENV=development API_PORT=3001 JWT_SECRET=dev-jwt-secret-change-in-prod DATABASE_URL=$DATABASE_URL node dist/main.js"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/web && pnpm dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "node apps/api/dist/main.js & npx serve -s apps/web/dist -l 5000"]
build = ["bash", "-c", "cd /home/runner/workspace && npm install -g pnpm@10.33.0 && pnpm install && pnpm --filter @sportsbooking/shared build && pnpm --filter @sportsbooking/api exec npx prisma generate && pnpm --filter @sportsbooking/api exec npx nest build && pnpm --filter @sportsbooking/web exec npx vite build"]
