# ---- API ----
NODE_ENV=development
API_PORT=3001

# ---- Postgres (matches docker-compose.yml) ----
# RUNTIME role: a NON-superuser, NOBYPASSRLS role so Postgres Row-Level Security
# is enforced as a real second layer behind the in-code ownerId scoping. The app
# sets app.current_owner_id / app.bypass_rls per request (DbService.withTenant /
# withTenantBypass) and the RLS policies (src/db/rls-policies.sql) filter rows.
# `pnpm db:push` creates this role + grants automatically (src/db/role-setup.sql).
DATABASE_URL=postgresql://sportsbooking_app:sportsbooking_app@localhost:5434/sportsbooking?schema=public
# ADMIN role (superuser): used ONLY for schema changes / migrations
# (pnpm db:push, db:generate) and the seed (pnpm db:seed). Never used by the app.
DATABASE_ADMIN_URL=postgresql://sportsbooking:sportsbooking@localhost:5434/sportsbooking?schema=public

# Redis (slot locks / queues)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
OTP_TTL_SECONDS=300

# Razorpay (test keys)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# Messaging
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_API_URL=
SMS_API_KEY=
# driver: "log" (dev, prints to console) | "live"
NOTIFICATION_DRIVER=log

# Loyalty / referral platform defaults (owner-overridable)
DEFAULT_LOYALTY_EARN_RATE=0.05
DEFAULT_LOYALTY_REDEEM_VALUE=1
DEFAULT_REFERRAL_REWARD=100

# CORS allowlist (comma-separated) — enforced in production only
WEB_ORIGIN=http://localhost:5001

# ---- WEB ----
VITE_API_BASE_URL=http://localhost:3001
