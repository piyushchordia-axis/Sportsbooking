// Multi-Venue Sports Booking & Facility Management Platform
// Data model — maps to PRD §8.1. Multi-tenant: tenant = Owner.
// Tenant isolation is enforced at the DB layer via Row-Level Security
// (see migrations/*_rls/migration.sql), keyed on owner_id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (mirror packages/shared/src/enums.ts)
// ---------------------------------------------------------------------------

enum UserRole {
  super_admin
  owner
  staff
  customer
}

enum OwnerStatus {
  active
  suspended
  pending
}

enum UnitLabel {
  court
  turf
  lane
  net
}

enum SlotStatus {
  open
  booked
  blocked
}

enum DayType {
  weekday
  weekend
}

enum TimeBand {
  morning
  afternoon
  evening
}

enum PayMode {
  prepay
  at_venue
}

enum PaymentStatus {
  pending
  paid
  awaiting_venue_settlement
  settled_at_venue
  refunded
  failed
}

enum BookingStatus {
  confirmed
  cancelled
  completed
  no_show
}

enum PackExpiryMode {
  forfeit
  rollover
  none
}

enum PackPricingMode {
  flat
  discount
}

enum LedgerTxnType {
  pack_buy
  pack_debit
  pack_refund
  points_earn
  points_redeem
  referral_reward
  no_show_fee
  cash_refund
  open_match_settle
}

enum ReferralStatus {
  pending
  rewarded
  expired
}

enum OpenMatchStatus {
  open
  full
  cancelled
  completed
}

enum OpenMatchRepaymentMode {
  info
  ledger
}

enum JoinRequestStatus {
  requested
  approved
  rejected
}

enum AddonType {
  rental
  cafe
  coaching
}

enum TournamentFormat {
  knockout
  league
  round_robin
}

enum RegistrationType {
  solo
  team
}

enum FeeBasis {
  per_player
  per_team
}

enum OfferType {
  percent
  flat
}

enum SkillLevel {
  beginner
  advanced_beginner
  advanced
  pro
}

// ---------------------------------------------------------------------------
// Super Admin: global game catalogue (PRD §3.1)
// ---------------------------------------------------------------------------

model GameCatalogue {
  id                 String    @id @default(uuid())
  name               String    @unique
  iconUrl            String?
  slotGranularityMin Int       @default(60) // 30 / 60 / 90
  unitLabel          UnitLabel @default(court)
  minPlayers         Int       @default(2)
  maxPlayers         Int       @default(4)
  defaultOpenTime    String    @default("06:00") // "HH:mm"
  defaultCloseTime   String    @default("23:00")
  createdAt          DateTime  @default(now())

  venues VenueGame[]
  units  BookableUnit[]

  @@map("game_catalogue")
}

// ---------------------------------------------------------------------------
// Tenant root: Owner (PRD §2.2, §8.1)
// ---------------------------------------------------------------------------

model Owner {
  id             String      @id @default(uuid())
  name           String
  contactEmail   String
  contactMobile  String?
  status         OwnerStatus @default(pending)
  venueQuota     Int         @default(1)
  allowedGameIds String[]    @default([])
  featureFlags   String[]    @default([]) // FeatureFlag values

  // Branding (white-label, PRD §4.10)
  logoUrl        String?
  primaryColor   String  @default("#0EA5E9")
  secondaryColor String  @default("#0F172A")
  accentColor    String  @default("#22C55E")

  // Commercial terms (PRD §3.2)
  setupFee       Decimal?  @db.Decimal(12, 2)
  amcAmount      Decimal?  @db.Decimal(12, 2)
  amcRenewalDate DateTime?

  // Loyalty/referral config (platform default, owner-overridable; PRD §4.5)
  loyaltyEarnRate    Decimal @default("0.05") @db.Decimal(6, 4)
  loyaltyRedeemValue Decimal @default("1") @db.Decimal(10, 2)
  referralReward     Decimal @default("100") @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  venues          Venue[]
  packs           MembershipPack[]
  ledgerTxns      LedgerTxn[]
  referrals       Referral[]
  offers          Offer[]
  customerLinks   OwnerCustomer[]
  auditLogs       AuditLog[]

  @@map("owners")
}

// ---------------------------------------------------------------------------
// Users: owner admins, staff, customers, super admin
// Customers are global (one login, many owners), but their PLAYER PROFILE /
// CRM record is per-owner (OwnerCustomer + PlayerProfile).
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  role         UserRole
  // owner admins + staff belong to a tenant; customers & super_admin: null
  ownerId      String?
  name         String
  email        String?  @unique
  mobile       String?  @unique
  passwordHash String? // owner/staff only
  // staff venue scoping (PRD §2.1)
  assignedVenueIds String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  owner          Owner?           @relation(fields: [ownerId], references: [id])
  bookings       Booking[]
  hostedMatches  OpenMatch[]      @relation("MatchHost")
  joinRequests   OpenMatchJoinRequest[]
  ledgerTxns     LedgerTxn[]
  playerProfiles PlayerProfile[]
  referralsMade  Referral[]       @relation("Referrer")
  referralsGot   Referral[]       @relation("Referee")
  ownerLinks     OwnerCustomer[]

  @@index([ownerId])
  @@map("users")
}

// CRM link + capture record: a customer known to a given owner (PRD §4.9)
model OwnerCustomer {
  id          String   @id @default(uuid())
  ownerId     String
  customerId  String
  firstSeenAt DateTime @default(now())
  lastVisitAt DateTime @default(now())
  bookingCount Int     @default(0)
  consent     Boolean  @default(false) // DPDP consent capture
  optedOut    Boolean  @default(false)

  owner    Owner @relation(fields: [ownerId], references: [id])
  customer User  @relation(fields: [customerId], references: [id])

  @@unique([ownerId, customerId])
  @@index([ownerId])
  @@map("owner_customers")
}

// Per-owner player profile (skill level powers open-match matching; PRD §5.1)
model PlayerProfile {
  id         String      @id @default(uuid())
  ownerId    String
  customerId String
  name       String
  mobile     String
  games      String[]    @default([])
  skillLevel SkillLevel  @default(beginner)
  consent    Boolean     @default(false)
  createdAt  DateTime    @default(now())

  customer User @relation(fields: [customerId], references: [id])

  @@unique([ownerId, customerId])
  @@index([ownerId])
  @@map("player_profiles")
}

// ---------------------------------------------------------------------------
// Venues & bookable units (PRD §4.1)
// ---------------------------------------------------------------------------

model Venue {
  id             String   @id @default(uuid())
  ownerId        String
  name           String
  geoLat         Float?
  geoLng         Float?
  address        String?
  city           String?
  contactPhone   String?
  photos         String[] @default([])
  openTime       String   @default("06:00")
  closeTime      String   @default("23:00")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  owner     Owner          @relation(fields: [ownerId], references: [id])
  games     VenueGame[]
  units     BookableUnit[]
  settings  VenueSettings?
  addons    Addon[]
  tournaments Tournament[]

  @@index([ownerId])
  @@index([city])
  @@map("venues")
}

model VenueGame {
  venueId String
  gameId  String

  venue Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  game  GameCatalogue @relation(fields: [gameId], references: [id])

  @@id([venueId, gameId])
  @@map("venue_games")
}

model VenueSettings {
  venueId               String                 @id
  cancellationTemplate  String                 @default("flexible") // flexible/moderate/strict
  noShowFee             Decimal                @default("0") @db.Decimal(10, 2)
  loyaltyEarnRate       Decimal?               @db.Decimal(6, 4) // overrides owner default
  loyaltyRedeemValue    Decimal?               @db.Decimal(10, 2)
  openMatchRepaymentMode OpenMatchRepaymentMode @default(info)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_settings")
}

model BookableUnit {
  id        String    @id @default(uuid())
  venueId   String
  ownerId   String // denormalised for RLS
  name      String
  label     UnitLabel @default(court)
  gameId    String
  capacity  Int       @default(4)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  game         GameCatalogue @relation(fields: [gameId], references: [id])
  pricingRules PricingRule[]
  slots        Slot[]

  @@index([venueId])
  @@index([ownerId])
  @@map("bookable_units")
}

// ---------------------------------------------------------------------------
// Dynamic pricing — per court, most-specific-rule-wins (PRD §4.2)
// ---------------------------------------------------------------------------

model PricingRule {
  id           String    @id @default(uuid())
  unitId       String
  ownerId      String // denormalised for RLS
  // null dimensions = "applies to all"; more non-null dims = more specific
  dayType      DayType?
  timeBand     TimeBand?
  dateOverride DateTime? @db.Date
  minDuration  Int? // minutes, for duration-tier discount
  price        Decimal   @db.Decimal(10, 2)
  createdAt    DateTime  @default(now())

  unit BookableUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([ownerId])
  @@map("pricing_rules")
}

// ---------------------------------------------------------------------------
// Slots & blocks (PRD §4.3) — a Slot row exists once it is booked or blocked;
// open availability is computed from operating hours + granularity.
// ---------------------------------------------------------------------------

model Slot {
  id        String     @id @default(uuid())
  unitId    String
  ownerId   String // denormalised for RLS
  startsAt  DateTime
  endsAt    DateTime
  status    SlotStatus @default(booked)
  blockReason String?
  bookingId String?
  createdAt DateTime   @default(now())

  unit    BookableUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  booking Booking?     @relation(fields: [bookingId], references: [id])

  // a unit can have at most one occupying slot per start time
  @@unique([unitId, startsAt])
  @@index([unitId, startsAt])
  @@index([ownerId])
  @@map("slots")
}

// ---------------------------------------------------------------------------
// Bookings (PRD §4.3, §5.2, §6.1)
// ---------------------------------------------------------------------------

model Booking {
  id              String        @id @default(uuid())
  ownerId         String
  venueId         String
  customerId      String
  status          BookingStatus @default(confirmed)
  payMode         PayMode
  paymentStatus   PaymentStatus @default(pending)
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @default("0") @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  packId          String?
  offerId         String?
  pointsRedeemed  Decimal       @default("0") @db.Decimal(12, 2)
  noShowFeeApplied Boolean      @default(false)
  // recurring series grouping (PRD §5.2)
  seriesId        String?
  razorpayOrderId String?
  razorpayPaymentId String?
  idempotencyKey  String?       @unique
  createdAt       DateTime      @default(now())

  slots  Slot[]
  addons BookingAddon[]
  pack   MembershipPack? @relation(fields: [packId], references: [id])
  offer  Offer?          @relation(fields: [offerId], references: [id])
  customer User          @relation(fields: [customerId], references: [id])
  openMatch OpenMatch?

  @@index([ownerId])
  @@index([venueId])
  @@index([customerId])
  @@index([seriesId])
  @@map("bookings")
}

model BookingAddon {
  id        String  @id @default(uuid())
  bookingId String
  addonId   String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addon   Addon   @relation(fields: [addonId], references: [id])

  @@map("booking_addons")
}

// ---------------------------------------------------------------------------
// Memberships / packs (PRD §4.4)
// ---------------------------------------------------------------------------

model MembershipPack {
  id          String          @id @default(uuid())
  ownerId     String
  name        String
  sessions    Int
  price       Decimal         @db.Decimal(10, 2)
  validityDays Int? // null = no time validity
  expiryMode  PackExpiryMode  @default(forfeit)
  pricingMode PackPricingMode @default(flat)
  discountPct Decimal?        @db.Decimal(5, 2) // when pricingMode = discount
  flatRate    Decimal?        @db.Decimal(10, 2) // when pricingMode = flat
  // scope (PRD §4.4): applicable venues/courts; empty = all
  venueIds    String[]        @default([])
  unitIds     String[]        @default([])
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())

  owner    Owner     @relation(fields: [ownerId], references: [id])
  bookings Booking[]

  @@index([ownerId])
  @@map("membership_packs")
}

// ---------------------------------------------------------------------------
// Append-only ledger (PRD §7) — balances are DERIVED, never overwritten.
// balanceAfter is a cached running total for the (customer, owner, kind) lane.
// ---------------------------------------------------------------------------

model LedgerTxn {
  id           String        @id @default(uuid())
  ownerId      String
  customerId   String
  type         LedgerTxnType
  // amount semantics depend on type; sessions for pack lanes, currency for points/cash
  amount       Decimal       @db.Decimal(12, 2)
  balanceAfter Decimal       @db.Decimal(12, 2)
  // which balance lane this affects: "pack:<packId>" | "points" | "cash"
  lane         String
  refType      String? // e.g. "booking", "pack", "referral"
  refId        String?
  note         String?
  createdAt    DateTime      @default(now())

  owner    Owner @relation(fields: [ownerId], references: [id])
  customer User  @relation(fields: [customerId], references: [id])

  @@index([ownerId])
  @@index([customerId, lane])
  @@map("ledger_txns")
}

// ---------------------------------------------------------------------------
// Loyalty/referral (PRD §4.5)
// ---------------------------------------------------------------------------

model Referral {
  id                     String         @id @default(uuid())
  ownerId                String
  referrerId             String
  refereeId              String?
  code                   String
  status                 ReferralStatus @default(pending)
  rewardReleasedOnFirstPaid Boolean     @default(false)
  createdAt              DateTime       @default(now())

  owner    Owner @relation(fields: [ownerId], references: [id])
  referrer User  @relation("Referrer", fields: [referrerId], references: [id])
  referee  User? @relation("Referee", fields: [refereeId], references: [id])

  @@unique([ownerId, code])
  @@index([ownerId])
  @@map("referrals")
}

// ---------------------------------------------------------------------------
// Add-ons (PRD §4.6)
// ---------------------------------------------------------------------------

model Addon {
  id        String    @id @default(uuid())
  ownerId   String
  venueId   String
  name      String
  type      AddonType
  price     Decimal   @db.Decimal(10, 2)
  stock     Int? // null = unlimited
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  venue    Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings BookingAddon[]

  @@index([venueId])
  @@index([ownerId])
  @@map("addons")
}

// ---------------------------------------------------------------------------
// Open matches (PRD §5.3)
// ---------------------------------------------------------------------------

model OpenMatch {
  id            String          @id @default(uuid())
  ownerId       String
  bookingId     String          @unique
  hostId        String
  openSpots     Int
  skillMin      SkillLevel      @default(beginner)
  skillMax      SkillLevel      @default(pro)
  repaymentMode OpenMatchRepaymentMode @default(info)
  status        OpenMatchStatus @default(open)
  createdAt     DateTime        @default(now())

  booking      Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  host         User                   @relation("MatchHost", fields: [hostId], references: [id])
  joinRequests OpenMatchJoinRequest[]

  @@index([ownerId])
  @@map("open_matches")
}

model OpenMatchJoinRequest {
  id        String            @id @default(uuid())
  matchId   String
  playerId  String
  status    JoinRequestStatus @default(requested)
  createdAt DateTime          @default(now())

  match  OpenMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player User      @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
  @@map("open_match_join_requests")
}

// ---------------------------------------------------------------------------
// Tournaments (PRD §4.7)
// ---------------------------------------------------------------------------

model Tournament {
  id         String           @id @default(uuid())
  ownerId    String
  venueId    String
  name       String
  gameId     String
  format     TournamentFormat
  startDate  DateTime         @db.Date
  endDate    DateTime         @db.Date
  capacity   Int
  regType    RegistrationType
  feeBasis   FeeBasis
  fee        Decimal          @db.Decimal(10, 2)
  regCloseAt DateTime?
  refundAllowedAfterClose Boolean @default(false)
  createdAt  DateTime         @default(now())

  venue        Venue                    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  participants TournamentParticipant[]

  @@index([ownerId])
  @@index([venueId])
  @@map("tournaments")
}

model TournamentParticipant {
  id           String   @id @default(uuid())
  tournamentId String
  teamName     String?
  captainName  String
  captainMobile String
  paid         Boolean  @default(false)
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_participants")
}

// ---------------------------------------------------------------------------
// Offers & promotions (PRD §4.8)
// ---------------------------------------------------------------------------

model Offer {
  id         String    @id @default(uuid())
  ownerId    String
  name       String
  type       OfferType
  value      Decimal   @db.Decimal(10, 2)
  code       String?
  autoApply  Boolean   @default(false)
  validFrom  DateTime?
  validTo    DateTime?
  venueIds   String[]  @default([])
  gameIds    String[]  @default([])
  segment    String? // e.g. "lapsed", "weekend_regulars"
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  owner    Owner     @relation(fields: [ownerId], references: [id])
  bookings Booking[]

  @@unique([ownerId, code])
  @@index([ownerId])
  @@map("offers")
}

// ---------------------------------------------------------------------------
// Audit log on admin actions (PRD §7)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  ownerId   String?
  actorId   String
  actorRole UserRole
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  owner Owner? @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("audit_logs")
}
