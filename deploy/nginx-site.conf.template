# Sportline — host (public) Nginx server block.
# Mirrors the existing *.enaacreations.com sites on this server: terminate TLS
# here, proxy everything to the loopback-bound web container.
#
# Install (needs sudo — run on the server):
#   sudo cp deploy/nginx-site.conf.template /etc/nginx/sites-available/sportline.conf
#   # edit server_name + the proxy_pass port to match WEB_PORT in .env
#   sudo ln -sf /etc/nginx/sites-available/sportline.conf /etc/nginx/sites-enabled/sportline.conf
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d SUBDOMAIN.enaacreations.com   # adds managed SSL 443

server {
    server_name SUBDOMAIN.enaacreations.com;

    # Match the web container's upload ceiling so large logos/photos pass through.
    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8093;   # = WEB_PORT in .env
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    listen 80;
    listen [::]:80;
    # `certbot --nginx` rewrites the above to 443 ssl + an 80->443 redirect.
}
